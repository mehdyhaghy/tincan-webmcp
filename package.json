{
  "name": "tincan-webmcp",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "$npm_execpath run --parallel dev:api dev:web",
    "dev:api": "$npm_execpath --watch apps/api/src/index.ts",
    "dev:web": "vite --host 127.0.0.1 --port 5173 apps/demo-saas",
    "start": "$npm_execpath apps/api/src/index.ts",
    "build": "tsc -b && vue-tsc --noEmit -p apps/demo-saas/tsconfig.json && vite build apps/demo-saas",
    "typecheck": "tsc -b && vue-tsc --noEmit -p apps/demo-saas/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:secrets": "$npm_execpath scripts/check-secrets.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/bun": "1.4.0",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/tsconfig": "0.9.1",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.11"
  }
}
