[Unit]
Description=TinCan WebMCP API
After=network.target

[Service]
Type=simple
User=tincan
Group=tincan
WorkingDirectory=/opt/tincan
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=8787
Environment=TRUST_PROXY=1
ExecStart=/usr/local/bin/bun /opt/tincan/apps/api/src/index.ts
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
